# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Archived Python legacy version
python_legacy/

# Local folders
logs/
downloads/

# Credentials (never commit)
credentials.json

# Pytest cache
.pytest_cache/
*$py.class

# Ignore local backups and large bundles
backups/

# Ignore build artifacts and executable distributions
build/
dist/
bin/
*.exe
*.bundle

# Installer / packaging outputs
installer/output/
installer/inno/installer/output/

# Playwright browsers in dist
dist/**/playwright_browsers/

# Virtual envs
.venv/
venv/

# Logs and test artifacts
test_logs/
*.log
thread_dump_*.txt
mainloop_unresponsive_marker.txt
epstein_downloader_gui.py.backup*
*.bak
tools/collected_logs/

# .NET
dotnet/**/bin/
dotnet/**/obj/
dotnet/publish/
dotnet/.vs/
*.user
_platypus_dirs.txt
dotnet/installer/output/
dotnet/installer/WebsiteDownloader.wxs
dotnet/installer/License.rtf
dotnet/installer/publish/
installer/msi/output/
.wix/
