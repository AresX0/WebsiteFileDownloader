<Window x:Class="WebsiteDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WebsiteDownloader.UI.ViewModels"
        Title="Website File Downloader" 
        Height="850" Width="1200" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico"
        Background="{DynamicResource SurfaceBrush}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Closing="OnWindowClosing"
        KeyDown="OnKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource SurfaceLightBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Click="OnSettingsClick" InputGestureText="Ctrl+,"/>
                <MenuItem Header="Schedule _Downloads..." Click="OnScheduleClick"/>
                <Separator/>
                <MenuItem Header="_Open Output Folder" Click="OnOpenOutputFolderClick"/>
                <MenuItem Header="Open _Log Folder" Click="OnOpenLogFolderClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Theme" Click="OnToggleThemeClick" InputGestureText="Ctrl+T"/>
                <MenuItem Header="View _Skipped Files" Click="OnViewSkippedClick"/>
                <MenuItem Header="Export File _Tree (JSON)" Click="OnExportFileTreeClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
                <MenuItem Header="Check for _Updates" Click="OnCheckUpdatesClick"/>
                <MenuItem Header="Report _Issue" Click="OnReportIssueClick"/>
            </MenuItem>
        </Menu>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Control: Downloader + History -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

                <!-- ===== DOWNLOADER TAB ===== -->
                <TabItem Header="Downloader">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="3*" MinHeight="120"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*" MinHeight="100"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Title + Profile Selector -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="logo.png" Width="48" Height="48" 
                                   Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Grid.Column="1" Text="Website File Downloader" 
                                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="4" ItemsSource="{Binding Profiles}" 
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name" VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Row 1: URL Input + Queue -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="URL:" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" x:Name="UrlTextBox"
                                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Padding="8,6" FontSize="14"
                                             Margin="0,0,10,0"
                                             ToolTip="Enter a website URL, or drag-and-drop a .txt file with URLs"/>
                                    <Button Grid.Column="2" Content="+ Add to Queue" MinWidth="120" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}" Click="OnAddUrlToQueue"
                                            ToolTip="Add URL to the queue list"/>
                                    <Button Grid.Column="3" Content="🔍 Scan Website" MinWidth="150" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButton}" Click="OnScanClick"
                                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                            ToolTip="Scan the website for downloadable files"/>
                                    <Button Grid.Column="4" Content="Test Link" MinWidth="80"
                                            Style="{StaticResource SecondaryButton}" Click="OnTestLinkClick"
                                            ToolTip="Test if the URL is reachable (HEAD request)"/>
                                </Grid>

                                <!-- URL Queue -->
                                <Expander Grid.Row="1" Header="URL Queue" Margin="0,6,0,0" IsExpanded="False"
                                          Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ListBox x:Name="QueueListBox" Grid.Column="0" 
                                                 ItemsSource="{Binding QueueUrls}" Height="100"
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Remove" Click="OnQueueRemove"/>
                                                    <MenuItem Header="Move Up" Click="OnQueueMoveUp"/>
                                                    <MenuItem Header="Move Down" Click="OnQueueMoveDown"/>
                                                    <MenuItem Header="Copy URL" Click="OnQueueCopyUrl"/>
                                                    <MenuItem Header="Open in Browser" Click="OnQueueOpenInBrowser"/>
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                        </ListBox>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Button Content="▲" Click="OnQueueMoveUp" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" Width="32" ToolTip="Move up"/>
                                            <Button Content="▼" Click="OnQueueMoveDown" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" Width="32" ToolTip="Move down"/>
                                            <Button Content="✕" Click="OnQueueRemove" Style="{StaticResource DangerButton}" Margin="0,0,0,4" Width="32" ToolTip="Remove"/>
                                            <Button Content="🗑" Click="OnQueueClear" Style="{StaticResource DangerButton}" Width="32" ToolTip="Clear all"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </Grid>
                        </Border>

                        <!-- Row 2: Download Options -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Column 0: File Types -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="File Types" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content=" Documents (PDF, DOC, XLS...)"
                                          IsChecked="{Binding DownloadDocuments}" Margin="0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Download document files including PDF, DOC, XLS, PPT, TXT, CSV, RTF"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" Content=" Images (JPG, PNG, SVG...)"
                                          IsChecked="{Binding DownloadImages}" Margin="0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Download image files including JPG, PNG, GIF, SVG, WEBP, BMP, TIFF"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" Content=" Videos (MP4, AVI, MKV...)"
                                          IsChecked="{Binding DownloadVideos}" Margin="0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Download video files including MP4, AVI, MKV, MOV, WMV, FLV"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" Content=" Archives (ZIP, RAR, 7Z...)"
                                          IsChecked="{Binding DownloadArchives}" Margin="0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Download archive files including ZIP, RAR, 7Z, TAR, GZ"/>

                                <!-- Column 1: Crawl Settings -->
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Crawl Settings" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,6"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content=" Follow Pagination"
                                          IsChecked="{Binding FollowPagination}" Margin="16,3,0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Follow ?page=N links to get all results"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="16,3,0,3">
                                    <TextBlock Text="Max Pages:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding MaxPaginationPages}" Width="70" VerticalContentAlignment="Center" Padding="4,2"
                                             ToolTip="Maximum number of pages to crawl (0 = unlimited)"/>
                                </StackPanel>
                                <CheckBox Grid.Row="3" Grid.Column="1" Content=" Recursive Crawl Sub-links"
                                          IsChecked="{Binding RecursiveCrawl}" Margin="16,3,0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Follow discovered links to sub-pages and scan those too"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="16,3,0,3">
                                    <TextBlock Text="Max Depth:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding MaxDepth}" Width="50" VerticalContentAlignment="Center" Padding="4,2"
                                             ToolTip="Maximum recursion depth"/>
                                </StackPanel>

                                <!-- Column 2: Advanced -->
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Advanced" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,6"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content=" Use Browser (Playwright)"
                                          IsChecked="{Binding UseBrowserForScan}" Margin="16,3,0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Use a real browser for JS-rendered pages or CAPTCHA sites"/>
                                <CheckBox Grid.Row="2" Grid.Column="2" Content=" Headless Browser"
                                          IsChecked="{Binding HeadlessBrowser}" Margin="16,3,0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          IsEnabled="{Binding UseBrowserForScan}"
                                          ToolTip="Run the browser without a visible window"/>
                                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="16,3,0,3">
                                    <TextBlock Text="Concurrent:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding MaxConcurrentDownloads}" Width="50" VerticalContentAlignment="Center" Padding="4,2"
                                             ToolTip="Number of simultaneous downloads (1-32)"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="16,3,0,3">
                                    <TextBlock Text="Delay (ms):" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding RequestDelayMs}" Width="70" VerticalContentAlignment="Center" Padding="4,2"
                                             ToolTip="Delay between HTTP requests in milliseconds"/>
                                </StackPanel>
                                <CheckBox Grid.Row="5" Grid.Column="2" Content=" Skip Duplicates (SHA-256)"
                                          IsChecked="{Binding SkipDuplicates}" Margin="16,3,0,3"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="Hash downloaded files and skip duplicates across runs"/>
                            </Grid>
                        </Border>

                        <!-- Row 3: URL Pattern Filter + Output -->
                        <Border Grid.Row="3" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="URL Filter (regex):" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding UrlPattern, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Padding="8,6"
                                         ToolTip="Optional regex to filter file URLs (e.g., \.pdf$ for PDFs only)"/>
                                <TextBlock Grid.Column="3" Text="Output:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="4" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Padding="8,6" Margin="0,0,10,0"
                                         ToolTip="Output directory for downloaded files"/>
                                <Button Grid.Column="5" Content="📁 Browse" MinWidth="100"
                                        Style="{StaticResource SecondaryButton}" Click="OnBrowseClick"
                                        ToolTip="Browse for output directory"/>
                            </Grid>
                        </Border>

                        <!-- Row 4: Action Buttons -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="⬇ Download Selected" Click="OnDownloadClick" MinWidth="170" Margin="0,0,8,0"
                                    Style="{StaticResource SuccessButton}" ToolTip="Download all selected files"/>
                            <Button Content="⏸ Pause" Click="OnPauseClick" MinWidth="80" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Pause all active downloads"
                                    IsEnabled="{Binding IsDownloading}"/>
                            <Button Content="▶ Resume" Click="OnResumeClick" MinWidth="85" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Resume paused downloads"
                                    IsEnabled="{Binding IsPaused}"/>
                            <Button Content="⏹ Cancel" Click="OnCancelClick" MinWidth="100" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" ToolTip="Cancel all downloads"/>
                            <Button Content="☑ Select All" Click="OnSelectAllClick" MinWidth="110" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button Content="☐ Select None" Click="OnSelectNoneClick" MinWidth="120" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button Content="🗑 Clear" Command="{Binding ClearCommand}" MinWidth="80" Margin="0,0,16,0"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <!-- Row 5: Summary Bar -->
                        <Border Grid.Row="5" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4"
                                Padding="8,4" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Items: "/><Run Text="{Binding DownloadItems.Count, Mode=OneWay, FallbackValue=0}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{StaticResource AccentBrush}">
                                    <Run Text="Completed: "/><Run Text="{Binding CompletedCount, FallbackValue=0}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{StaticResource DangerBrush}">
                                    <Run Text="Failed: "/><Run Text="{Binding FailedCount, FallbackValue=0}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{StaticResource WarningBrush}">
                                    <Run Text="Skipped: "/><Run Text="{Binding SkippedCount, FallbackValue=0}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="⏳ Scanning..." FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas">
                                    <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="7" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas">
                                    <Run Text="{Binding EtaText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Row 6: GridSplitter -->
                        <GridSplitter Grid.Row="6" Height="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}" Cursor="SizeNS" ResizeDirection="Rows"/>

                        <!-- Row 7: Download Queue DataGrid -->
                        <Border Grid.Row="7" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                Padding="4" Margin="0,4,0,8">
                            <DataGrid x:Name="DownloadItemsDataGrid" ItemsSource="{Binding DownloadItems}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      SelectionMode="Single" IsReadOnly="True"
                                      ColumnHeaderHeight="32" RowHeight="28"
                                      Background="Transparent" BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy URL" Click="OnCopyItemUrl"/>
                                        <MenuItem Header="Open in Browser" Click="OnOpenItemInBrowser"/>
                                        <MenuItem Header="Retry Download" Click="OnRetryItem"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="45" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" MinWidth="60"/>
                                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="250" MinWidth="150"/>
                                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="350" MinWidth="200"/>
                                    <DataGridTextColumn Header="Page" Binding="{Binding PageNumber}" Width="55" MinWidth="45"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" MinWidth="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                        <Setter Property="Foreground" Value="#2196F3"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Skipped (duplicate)">
                                                        <Setter Property="Foreground" Value="#FFA726"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                        <Setter Property="Foreground" Value="#FFA726"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Progress" Width="130" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding Progress}" Height="16" Minimum="0" Maximum="100"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Row 8: Splitter between DataGrid and Log -->
                        <GridSplitter Grid.Row="8" Height="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}" Cursor="SizeNS" ResizeDirection="Rows"/>

                        <!-- Row 9: Log Pane (always visible) -->
                        <Border Grid.Row="9" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                Padding="4" Margin="0,4,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="4,2,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📋 Log" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearLogCommand}"
                                            Style="{StaticResource SecondaryButton}" MinWidth="60" Padding="8,2"/>
                                </Grid>
                                <TextBox x:Name="LogTextBox" Grid.Row="1"
                                         Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0" TextChanged="OnLogTextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Row 10: Status Bar -->
                        <Border Grid.Row="10" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="Overall:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="2" Height="18" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                             Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Progress, StringFormat={}{0}%}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== DOWNLOAD HISTORY TAB ===== -->
                <TabItem Header="Download History">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filter bar -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Padding="8,6" Margin="0,0,10,0"
                                         ToolTip="Filter history by file name, URL, or status"/>
                                <Button Grid.Column="2" Content="Refresh" Click="OnRefreshHistory"
                                        Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="Clear History" Click="OnClearHistory"
                                        Style="{StaticResource DangerButton}" MinWidth="100"/>
                            </Grid>
                        </Border>

                        <!-- History text display -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6" Padding="8">
                            <TextBox Text="{Binding HistoryText, Mode=OneWay}" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"/>
                        </Border>
                    </Grid>
                </TabItem>
